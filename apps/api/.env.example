# Cổng API
PORT=3001
NODE_ENV=development

# PostgreSQL — chọn MỘT trong hai cách khai báo.
# Cách 1: một URL đầy đủ (dev local, docker-compose). Có URL thì URL được ưu tiên.
DATABASE_URL=postgres://reelforge:reelforge@localhost:5433/reelforge
# Cách 2: bộ thông số rời (Supabase, Neon, RDS...). Bỏ comment DATABASE_URL ở trên để dùng.
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=
# SSL tự bật khi host không phải localhost; đặt tường minh nếu muốn ép.
# DB_SSL=true

DB_LOGGING=false
# Trần lưu trữ (GB) để dashboard admin tính % chiếm dụng. Đặt bằng dung lượng database
# thực sự được phép dùng — chỗ trống của ổ đĩa ở dev, hạn mức của gói ở cloud.
DB_STORAGE_GB=40

# Redis — chọn MỘT trong hai cách khai báo.
# Cách 1: một URL đầy đủ (dev local, docker-compose)
REDIS_URL=redis://localhost:6379
# Cách 2: bộ thông số rời (Redis Cloud). Nếu có REDIS_URL thì URL được ưu tiên.
# REDIS_HOST=your-db.redis.io
# REDIS_PORT=14489
# REDIS_USERNAME=default
# REDIS_PASSWORD=
# REDIS_TLS=false

REDIS_KEY_PREFIX=reelforge
CACHE_TTL_MS=60000
# Redis Cloud không trả maxmemory qua INFO — khai báo dung lượng gói để dashboard
# tính được phần trăm bộ nhớ đã dùng.
REDIS_PLAN_MB=30

# Origin của apps/web, dùng cho CORS
WEB_ORIGIN=http://localhost:3000

# Khoá mã hoá credential nhà cung cấp (Google TTS...). Định dạng "version:base64",
# nhiều version cách nhau bằng dấu phẩy để xoay khoá được.
# Sinh khoá: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEYS="1:<base64 32 byte>"
CREDENTIAL_ENCRYPTION_KEY_VERSION=1

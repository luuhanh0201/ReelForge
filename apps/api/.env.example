# Cổng API
PORT=3001
NODE_ENV=development

# PostgreSQL — chọn MỘT trong hai cách khai báo.
# Cách 1: một URL đầy đủ (dev local, docker-compose). Có URL thì URL được ưu tiên.
DATABASE_URL=postgres://reelforge:reelforge@localhost:5433/reelforge
# Cách 2: bộ thông số rời (Supabase, Neon, RDS...). Bỏ comment DATABASE_URL ở trên để dùng.
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=
# SSL tự bật khi host không phải localhost; đặt tường minh nếu muốn ép.
# DB_SSL=true

DB_LOGGING=false
# Trần lưu trữ (GB) để dashboard admin tính % chiếm dụng. Đặt bằng dung lượng database
# thực sự được phép dùng — chỗ trống của ổ đĩa ở dev, hạn mức của gói ở cloud.
DB_STORAGE_GB=40

# Redis — chọn MỘT trong hai cách khai báo.
# Cách 1: một URL đầy đủ (dev local, docker-compose)
REDIS_URL=redis://localhost:6379
# Cách 2: bộ thông số rời (Redis Cloud). Nếu có REDIS_URL thì URL được ưu tiên.
# REDIS_HOST=your-db.redis.io
# REDIS_PORT=14489
# REDIS_USERNAME=default
# REDIS_PASSWORD=
# REDIS_TLS=false

REDIS_KEY_PREFIX=reelforge
CACHE_TTL_MS=60000
# Redis Cloud không trả maxmemory qua INFO — khai báo dung lượng gói để dashboard
# tính được phần trăm bộ nhớ đã dùng.
REDIS_PLAN_MB=30

# Origin của apps/web, dùng cho CORS
WEB_ORIGIN=http://localhost:3000

# Khoá mã hoá credential nhà cung cấp (Google TTS...). Định dạng "version:base64",
# nhiều version cách nhau bằng dấu phẩy để xoay khoá được.
# Sinh khoá: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEYS="1:<base64 32 byte>"
CREDENTIAL_ENCRYPTION_KEY_VERSION=1

# ------------------------------------------------------------------
# Xác thực Google & phiên đăng nhập
# ------------------------------------------------------------------
# Khoá ký access token (HS256). ĐỔI KHOÁ NÀY = TOÀN BỘ NGƯỜI DÙNG BỊ ĐĂNG XUẤT,
# giống như mất CREDENTIAL_ENCRYPTION_KEYS ở trên. Sinh khoá: openssl rand -base64 48
AUTH_JWT_SECRET=

# OAuth client dạng "Web application" trong Google Cloud Console.
# Authorized JavaScript origins phải có origin của apps/web (http://localhost:3000 khi dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Google được cấp vai admin ngay lần đăng nhập đầu — cách duy nhất để có admin
# đầu tiên, không seed cứng tài khoản nào vào database. Nhiều email cách nhau bằng dấu phẩy.
AUTH_BOOTSTRAP_ADMIN_EMAILS=

# Thời hạn phiên. Nhận dạng 15m / 2h / 30d hoặc số giây thuần.
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=30d
# Tài khoản nội bộ (viewer/editor/admin) sống ngắn hơn và tự hết hạn khi không thao tác.
AUTH_ADMIN_REFRESH_TTL=7d
AUTH_ADMIN_IDLE_TIMEOUT=30m
# Ân hạn cho refresh token vừa bị xoay, để nhiều tab cùng refresh không giết phiên.
AUTH_ROTATION_GRACE=30
AUTH_MAX_SESSIONS_PER_USER=10

# Cookie phiên. Để trống ở local; production dùng ".reelforge.vn" để cả reelforge.vn và
# api.reelforge.vn cùng đọc được cookie.
AUTH_COOKIE_DOMAIN=
# Mặc định bật theo NODE_ENV=production; chỉ đặt tường minh khi cần ép khác đi.
# AUTH_COOKIE_SECURE=true

# ------------------------------------------------------------------
# SMTP — cảnh báo bảo mật gửi tới chủ tài khoản
# ------------------------------------------------------------------
# Bỏ trống toàn bộ khối này thì tính năng tự tắt: nội dung mail chỉ ghi ra log server,
# đăng nhập và mọi nghiệp vụ khác vẫn chạy bình thường.
SMTP_HOST=
# 587 dùng STARTTLS, 465 dùng TLS ngay từ đầu.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Địa chỉ người gửi, ví dụ: ReelForge <no-reply@reelforge.vn>
SMTP_FROM=
